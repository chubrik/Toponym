{
  "compilerOptions": {
    "target": "es2015",
    "lib": [ "es2015", "dom" ],
    "module": "es2015",
    "moduleResolution": "node",
    "alwaysStrict": true,
    "declaration": false,
    "sourceMap": false,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "strictNullChecks": true,
    "suppressImplicitAnyIndexErrors": true,
    "skipLibCheck": true,
    "types": ["angular", "angular-ui-bootstrap", "angular-ui-router", "bootstrap", "jquery"],
    "baseUrl": ".",
    "rootDir": "./Toponym.Web/app/ts",
    "outDir": "./Toponym.Web/$temp/js"
  }
}
